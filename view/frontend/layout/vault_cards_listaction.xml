<?xml version="1.0"?>

<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="customer_account"/>
    <body>
        <referenceContainer name="content">
            <block class="GlobalPayments\PaymentGateway\Block\Customer\CreditCards" name="vault.cards.list" cacheable="false" template="GlobalPayments_PaymentGateway::cards_list.phtml" />
            <block
                class="GlobalPayments\PaymentGateway\Block\Customer\PayerTokens"
                name="globalpayments.vault.payer.tokens"
                cacheable="false"
                template="GlobalPayments_PaymentGateway::customer_account/payer_tokens.phtml" />
        </referenceContainer>
    </body>
</page>