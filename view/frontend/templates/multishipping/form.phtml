<?php
/**
 * GlobalPayments Multishipping Payment Form Template
 *
 * Renders the GlobalPayments payment component on the multishipping
 * billing page. Uses uiLayout to instantiate the multishipping-specific
 * JS renderer which handles tokenization and payment info submission.
 *
 * @var \Magento\Payment\Block\Form $block
 * @var \Magento\Framework\Escaper $escaper
 * @var \Magento\Framework\View\Helper\SecureHtmlRenderer $secureRenderer
 */

$scriptString = <<<SCRIPT
    require([
        'uiLayout',
        'jquery'
    ], function (layout, $) {
        $(function () {
            var el = document.getElementById('globalpayments-multishipping-config');
            var paymentMethodData = {
                method: el.getAttribute('data-method')
            };

            layout([
                {
                    component: 'GlobalPayments_PaymentGateway/js/view/payment/method-renderer/multishipping/globalpayments',
                    name: 'payment_method_' + paymentMethodData.method,
                    method: paymentMethodData.method,
                    item: paymentMethodData
                }
            ]);

            $('body').trigger('contentUpdated');
        });
    });
SCRIPT;
?>
<div id="globalpayments-multishipping-config" data-method="<?= $escaper->escapeHtmlAttr($block->getMethod()->getCode()) ?>" hidden></div>
<?= /* @noEscape */ $secureRenderer->renderTag('script', [], $scriptString, false) ?>
