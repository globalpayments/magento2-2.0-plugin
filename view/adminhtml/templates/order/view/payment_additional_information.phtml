<?php

use GlobalPayments\PaymentGateway\Block\Adminhtml\Order\View\PaymentAdditionalInformation;

/**
 * @var PaymentAdditionalInformation $block
 */

$authorizationCode = $block->getAuthorizationCode();
$cardIssuerResponseData = $block->getCardIssuerResponseData();
$globalPaymentsOrderId = $block->getGlobalPaymentsOrderId();
$resultCode = $block->getResultCode();
$threeDSecureStatus = $block->getThreeDSecureStatus();
$tokenResponseDetails = $block->getTokenResponseDetails();
$installmentData = $block->getInstallmentData();
$magentoOrderId = $block->getMagentoOrderId();
?>
<?php if ($block->canDisplayInfo()): ?>
    <table class="data-table admin__table-secondary order-information-table">
        <tbody>
            <?php if ($globalPaymentsOrderId): ?>
                <tr>
                    <th>
                        <?= $escaper->escapeHtml(__('Order ID')); ?>
                    </th>
                    <td>
                        <?= $escaper->escapeHtml($globalPaymentsOrderId); ?>
                    </td>
                </tr>
            <?php endif; ?>
            <?php if ($resultCode): ?>
                <tr>
                    <th>
                        <?= $escaper->escapeHtml(__('Result Code')); ?>
                    </th>
                    <td>
                        <?= $escaper->escapeHtml($resultCode); ?>
                    </td>
                </tr>
            <?php endif; ?>
            <?php if ($authorizationCode): ?>
                <tr>
                    <th>
                        <?= $escaper->escapeHtml(__('Auth Code')); ?>
                    </th>
                    <td>
                        <?= $escaper->escapeHtml($authorizationCode); ?>
                    </td>
                </tr>
            <?php endif; ?>
            <?php if ($tokenResponseDetails): ?>
                <?php if ($tokenResponseDetails['cardType']): ?>
                    <tr>
                        <th>
                            <?= $escaper->escapeHtml(__('Card Type')); ?>
                        </th>
                        <td>
                            <?= $escaper->escapeHtml(strtoupper($tokenResponseDetails['cardType'])); ?>
                        </td>
                    </tr>
                <?php endif; ?>
                <?php if ($tokenResponseDetails['cardLast4']): ?>
                    <tr>
                        <th>
                            <?= $escaper->escapeHtml(__('Card Number')); ?>
                        </th>
                        <td>
                            <?= $escaper->escapeHtml('xxxx-' . $tokenResponseDetails['cardLast4']); ?>
                        </td>
                    </tr>
                <?php endif; ?>
            <?php endif; ?>
            <?php if ($cardIssuerResponseData): ?>
                <?php if ($cardIssuerResponseData->cvvResult): ?>
                    <tr>
                        <th>
                            <?= $escaper->escapeHtml(__('CVN Result')); ?>
                        </th>
                        <td>
                            <?= $escaper->escapeHtml($cardIssuerResponseData->cvvResult); ?>
                        </td>
                    </tr>
                <?php endif; ?>
                <?php if ($cardIssuerResponseData->avsAddressResult): ?>
                    <tr>
                        <th>
                            <?= $escaper->escapeHtml(__('AVS Address Result')); ?>
                        </th>
                        <td>
                            <?= $escaper->escapeHtml($cardIssuerResponseData->avsAddressResult); ?>
                        </td>
                    </tr>
                <?php endif; ?>
                <?php if ($cardIssuerResponseData->avsPostalCodeResult): ?>
                    <tr>
                        <th>
                            <?= $escaper->escapeHtml(__('AVS Postcode Result')); ?>
                        </th>
                        <td>
                            <?= $escaper->escapeHtml($cardIssuerResponseData->avsPostalCodeResult); ?>
                        </td>
                    </tr>
                <?php endif; ?>
                <?php if ($threeDSecureStatus): ?>
                    <tr>
                        <th>
                            <?= $escaper->escapeHtml(__('3D Secure Status')); ?>
                        </th>
                        <td>
                            <?= $escaper->escapeHtml($threeDSecureStatus); ?>
                        </td>
                    </tr>
                <?php endif; ?>
            <?php endif; ?>
            <?php if ($installmentData): ?>
                <tr>
                    <th colspan="2" style="background-color: #f5f5f5; font-weight: bold;">
                        <?= $escaper->escapeHtml(__('Installment Information')); ?>
                    </th>
                </tr>
                <?php if ($magentoOrderId): ?>
                    <tr>
                        <th>
                            <?= $escaper->escapeHtml(__('Order ID')); ?>
                        </th>
                        <td>
                            <?= $escaper->escapeHtml($magentoOrderId); ?>
                        </td>
                    </tr>
                <?php endif; ?>
                <?php if ($resultCode): ?>
                    <tr>
                        <th>
                            <?= $escaper->escapeHtml(__('Response')); ?>
                        </th>
                        <td>
                            <?= $escaper->escapeHtml($resultCode); ?>
                        </td>
                    </tr>
                <?php endif; ?>
                <?php if ($authorizationCode): ?>
                    <tr>
                        <th>
                            <?= $escaper->escapeHtml(__('Auth Code')); ?>
                        </th>
                        <td>
                            <?= $escaper->escapeHtml($authorizationCode); ?>
                        </td>
                    </tr>
                <?php endif; ?>
                <?php if (!empty($installmentData->count)): ?>
                    <tr>
                        <th>
                            <?= $escaper->escapeHtml(__('Installments Number')); ?>
                        </th>
                        <td>
                            <?= $escaper->escapeHtml($installmentData->count. ' ' . __('installments')); ?>
                        </td>
                    </tr>
                <?php endif; ?>
            <?php endif; ?>
        </tbody>
    </table>
<?php endif; ?>
